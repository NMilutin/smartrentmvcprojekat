@model IEnumerable<SmartRent.Models.Iznajmljivanje>

@{
    ViewBag.Title = "Rezervacije";
}

<h2>Rezervacije</h2>

<table class="table">
    <tr>
        <th>Automobil</th>
        <th>
            Datum rezervacije
        </th>
        <th>
            Datum vracanja
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @item.Automobil.ToString()
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.DatumIznajmljivanja)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.DatumVracanja)
        </td>
        <td>
            @Html.ActionLink("Uredi", "UrediRezervaciju", new { id=item.Id }) |
            @Html.ActionLink("Obrisi", "ObrisiRezervaciju", new { id=item.Id })
        </td>
    </tr>
}

</table>
