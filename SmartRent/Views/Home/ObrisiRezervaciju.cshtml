@model SmartRent.Models.Iznajmljivanje

@{
    ViewBag.Title = "ObrisiRezervaciju";
}

<h2>Brisanje rezervacije</h2>

<div>
    <h4>Da li ste sigurni da zelite da obrisete rezervaciju za @Model.Automobil.ToString()</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            Datum rezervacije
        </dt>

        <dd>
            @Html.DisplayFor(model => model.DatumIznajmljivanja)
        </dd>

        <dt>
            Datum vracanja
        </dt>

        <dd>
            @Html.DisplayFor(model => model.DatumVracanja)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Obrisi" class="btn btn-default" /> |
            @Html.ActionLink("Nazad na listu", "Rezervacije")
        </div>
    }
</div>
